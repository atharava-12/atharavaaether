SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Local development:
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:4b

# Public deployment: set AI_PROVIDER=nvidia and keep this key in the host's
# encrypted environment settings. Never add a real key to this file.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=YOUR_SERVER_SIDE_NVIDIA_API_KEY

# Optional generic OpenAI-compatible cloud provider:
CLOUD_AI_BASE_URL=
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=

ALLOWED_ORIGINS=http://localhost:5173,https://chitchatgen.com,https://www.chitchatgen.com
